-- Shared raster atlas for map instances: same original geometry, one GUI image
-- per icon instead of dozens of frames/strokes. Menu artwork remains unchanged.
local atlas=nil;local atlasCells={};local atlasAttempted=false
function Art.prepareMapIcons()
 if atlasAttempted then return end;atlasAttempted=true
 local ok,img=pcall(function()return game:GetService("AssetService"):CreateEditableImage({Size=Vector2.new(512,256)})end)
 if not ok or not img then return end
 local pixels=buffer.create(512*256*4);local deadline=os.clock()+.002
 local kinds={"City","Factory","DefensePost","Port","SAMLauncher","MissileSilo","TransportShip","Warship","TradeShip","Train","Carriage","AtomBomb","HydrogenBomb","MIRV","MIRVWarhead","SAMMissile","Shell","Crown"}
 for i,kind in ipairs(kinds)do
  local ox,oy=((i-1)%8)*64,math.floor((i-1)/8)*64;atlasCells[kind]=Vector2.new(ox,oy)
  local function line(x,y,xx,yy)
   x=x*56+4;y=y*56+4;xx=xx*56+4;yy=yy*56+4
   local dx,dy=xx-x,yy-y;local length=dx*dx+dy*dy
   for py=math.max(0,math.floor(math.min(y,yy)-3)),math.min(63,math.ceil(math.max(y,yy)+3))do
    for px=math.max(0,math.floor(math.min(x,xx)-3)),math.min(63,math.ceil(math.max(x,xx)+3))do
     local t=if length==0 then 0 else math.clamp(((px+.5-x)*dx+(py+.5-y)*dy)/length,0,1)
     local d=math.sqrt((px+.5-x-t*dx)^2+(py+.5-y-t*dy)^2)
     local alpha=math.floor(math.clamp(2.25-d,0,1)*255+.5);local offset=((oy+py)*512+ox+px)*4
     if alpha>buffer.readu8(pixels,offset+3)then buffer.writeu32(pixels,offset,16777215+alpha*16777216)end
    end
   end
  end
  local function ring(x,y,w,h)
   for n=0,31 do local a=n*math.pi/16;local b=(n+1)*math.pi/16;line(x+w/2+math.cos(a)*w/2,y+h/2+math.sin(a)*h/2,x+w/2+math.cos(b)*w/2,y+h/2+math.sin(b)*h/2)end
  end
  Art.geometry(kind,line,ring)
  if task and task.wait and os.clock()>=deadline then task.wait();deadline=os.clock()+.002 end
 end
 img:WritePixelsBuffer(Vector2.zero,Vector2.new(512,256),pixels);atlas=img
end
function Art.mapIconsReady()return atlas~=nil end
function Art.mapIcon(parent,kind,size,color)
