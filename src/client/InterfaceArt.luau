 local root=Instance.new("ImageLabel");root.Name=kind.."Icon";root.BackgroundTransparency=1;root.Size=UDim2.fromOffset(size,size);root.Active=false;root.ImageContent=Content.fromObject(atlas);root.ImageRectOffset=atlasCells[kind];root.ImageRectSize=Vector2.new(64,64);root.ImageColor3=color;root.Parent=parent
 return root
end
-- Original abstract profile art, seeded by the server-generated match name.
-- Never resolves a Roblox account, avatar thumbnail or friendship identity.
function Art.profile(parent,name,size)
 local seed=29
 for i=1,#name do seed=(seed*31+string.byte(name,i))%16777213 end
 local root=Instance.new("Frame");root.Name="GeneratedProfile";root.Size=UDim2.fromOffset(size,size);root.BorderSizePixel=0;root.BackgroundColor3=Color3.fromRGB(23+seed%25,29+math.floor(seed/25)%25,43+math.floor(seed/625)%25);root.Active=false;root.Parent=parent
 local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,8);corner.Parent=root
 local color=Color3.fromRGB(100+seed%140,110+math.floor(seed/140)%130,120+math.floor(seed/19600)%120)
 for y=0,3 do for x=0,1 do
  seed=(seed*97+31)%16777213
  if seed%3~=0 then for _,column in ipairs({x,3-x})do
   local tile=Instance.new("Frame");tile.Name="ProfileShape";tile.BorderSizePixel=0;tile.BackgroundColor3=color;tile.Position=UDim2.fromScale(.15+column*.18,.15+y*.18);tile.Size=UDim2.fromScale(.15,.15);tile.Rotation=if seed%2==0 then 45 else 0;tile.Active=false;tile.Parent=root
   local round=Instance.new("UICorner");round.CornerRadius=UDim.new(if seed%5==0 then 1 else 0,1);round.Parent=tile
  end end
 end end
 return root
end
function Art.world(parent,map)
 -- A dedicated low sibling branch; deferred imagery can never cover menu content.
 local world=Instance.new("Frame");world.Name="EarthSilhouette";world.BackgroundTransparency=1;world.Size=UDim2.fromScale(1,1);world.ZIndex=0;world.Active=false;world.ClipsDescendants=true;world.Parent=parent
